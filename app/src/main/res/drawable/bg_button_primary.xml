<?xml version="1.0" encoding="utf-8"?>
<!-- Botón primario de Reco: degradado horizontal verde azulado -> verde, esquinas de 16dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/verde_azulado"
                android:endColor="@color/verde" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>
</ripple>
