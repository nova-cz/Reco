<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo gris claro con manchas de color difuminadas (azul arriba-izquierda, durazno a la derecha, azul abajo). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo" />
        </shape>
    </item>
    <item
        android:width="520dp"
        android:height="520dp"
        android:left="-240dp"
        android:top="-140dp"
        android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="260dp"
                android:startColor="#C8D8F5"
                android:endColor="#00C8D8F5" />
        </shape>
    </item>
    <item
        android:width="460dp"
        android:height="460dp"
        android:right="-250dp"
        android:top="200dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="230dp"
                android:startColor="#F4DFD2"
                android:endColor="#00F4DFD2" />
        </shape>
    </item>
    <item
        android:width="520dp"
        android:height="520dp"
        android:left="-260dp"
        android:bottom="-200dp"
        android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="260dp"
                android:startColor="#C8D8F5"
                android:endColor="#00C8D8F5" />
        </shape>
    </item>
</layer-list>
