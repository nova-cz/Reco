<?xml version="1.0" encoding="utf-8"?>
<!-- Cascarón del modo vendedor: las pantallas reales llegan en una fase posterior. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/panel">

    <fragment
        android:id="@+id/panel"
        android:name="com.fcc.reco.ui.comun.PlaceholderFragment"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="titulo"
            android:defaultValue="Panel"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/anuncios"
        android:name="com.fcc.reco.ui.comun.PlaceholderFragment"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="titulo"
            android:defaultValue="Anuncios"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/ventas"
        android:name="com.fcc.reco.ui.comun.PlaceholderFragment"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="titulo"
            android:defaultValue="Ventas"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/perfilVendedor"
        android:name="com.fcc.reco.ui.comun.PerfilBasicoFragment"
        tools:layout="@layout/fragment_perfil_basico" />

    <fragment
        android:id="@+id/publicar1"
        android:name="com.fcc.reco.ui.vendedor.Publicar1Fragment"
        tools:layout="@layout/fragment_publicar_1" />

    <fragment
        android:id="@+id/publicar2"
        android:name="com.fcc.reco.ui.vendedor.Publicar2Fragment"
        tools:layout="@layout/fragment_publicar_2" />

    <fragment
        android:id="@+id/publicar3"
        android:name="com.fcc.reco.ui.vendedor.Publicar3Fragment"
        tools:layout="@layout/fragment_publicar_3" />

    <fragment
        android:id="@+id/publicar4"
        android:name="com.fcc.reco.ui.vendedor.Publicar4Fragment"
        tools:layout="@layout/fragment_publicar_4" />

    <fragment
        android:id="@+id/publicar5"
        android:name="com.fcc.reco.ui.vendedor.Publicar5Fragment"
        tools:layout="@layout/fragment_publicar_5" />
</navigation>
