<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/cerrar"
            style="@style/Reco.BotonCircular"
            android:contentDescription="@string/cerrar"
            android:src="@drawable/ic_cerrar" />

        <TextView
            style="@style/Reco.Texto.Boton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/pub_titulo"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/borrador"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/pub_borrador" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/paso_texto"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/paso_nombre"
            style="@style/Reco.Texto.Boton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>

    <com.fcc.reco.ui.comun.BarraPasos
        android:id="@+id/barra_pasos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:pasosTotal="5" />
</LinearLayout>
