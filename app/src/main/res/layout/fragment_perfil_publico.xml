<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="110dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/boton_atras"
                style="@style/Reco.BotonCircular"
                android:contentDescription="@string/volver"
                android:src="@drawable/ic_atras" />

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/perfil_publico_titulo"
                android:textSize="18sp" />
        </FrameLayout>

        <include
            android:id="@+id/tarjeta"
            layout="@layout/layout_tarjeta_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="@dimen/elevacion_suave"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_donde_entrega"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/lista_puntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Reco.Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pub_horario"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.fcc.reco.ui.comun.ChipFiltro
                android:id="@+id/tab_a_la_venta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.fcc.reco.ui.comun.ChipFiltro
                android:id="@+id/tab_resenas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/vacio"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reportar"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/perfil_reportar"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
