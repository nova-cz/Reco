<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="110dp">

        <com.fcc.reco.ui.comun.AvatarIniciales
            android:id="@+id/avatar"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/nombre"
            style="@style/Reco.Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/detalle"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <com.fcc.reco.ui.comun.ChipInsignia
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:insigniaTexto="@string/verificado_ok"
            app:insigniaTipo="verificado_azul" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_cambiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_salir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/cerrar_sesion"
            app:botonEstilo="secundario" />
    </LinearLayout>
</ScrollView>
