<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="110dp">

        <TextView
            style="@style/Reco.Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compras_titulo" />

        <TextView
            style="@style/Reco.Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/compras_subtitulo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.fcc.reco.ui.comun.ChipFiltro
                android:id="@+id/filtro_en_curso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.fcc.reco.ui.comun.ChipFiltro
                android:id="@+id/filtro_completadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:filtroTexto="@string/compras_completadas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/estado_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circulo_gris"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/ic_compras"
                app:tint="@color/texto_secundario" />

            <TextView
                android:id="@+id/vacio_titulo"
                style="@style/Reco.Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/vacio_desc"
                style="@style/Reco.Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/compras_vacio_desc" />

            <com.fcc.reco.ui.comun.BotonPildora
                android:id="@+id/boton_explorar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/explorar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
