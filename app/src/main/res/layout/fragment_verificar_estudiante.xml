<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/boton_atras"
                style="@style/Reco.BotonCircular"
                android:contentDescription="@string/volver"
                android:src="@drawable/ic_atras" />

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/verificacion"
                android:textSize="17sp" />
        </FrameLayout>

        <!-- Progreso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Reco.Texto.CuerpoMedio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/paso_2_de_3"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verificacion"
                android:textSize="13sp" />
        </LinearLayout>

        <com.fcc.reco.ui.comun.BarraPasos
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:pasosActual="2"
            app:pasosTotal="3" />

        <!-- Tarjeta principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="@dimen/elevacion_suave"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_icono_azul">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_birrete"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                style="@style/Reco.Texto.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/verifica_titulo"
                android:textSize="24sp" />

            <TextView
                style="@style/Reco.Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/verifica_desc" />
        </LinearLayout>

        <!-- Pasos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="@dimen/elevacion_suave"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circulo_tinta"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/verifica_paso_1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circulo_tinta"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/verifica_paso_2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circulo_tinta"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/verifica_paso_3" />
            </LinearLayout>
        </LinearLayout>

        <com.fcc.reco.ui.comun.ChipInsignia
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:insigniaTexto="@string/universidad_buap"
            app:insigniaTipo="verificado_azul" />

        <com.fcc.reco.ui.comun.ChipInsignia
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:insigniaTexto="@string/mas_universidades"
            app:insigniaTipo="neutro_gris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_escudo_ok"
                app:tint="@color/verde_insignia" />

            <TextView
                style="@style/Reco.Texto.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/privacidad_nota"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_institucional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/iniciar_sesion_institucional"
            app:botonIcono="@drawable/ic_enlace_externo" />

        <TextView
            android:id="@+id/enlace_no_aparece"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/universidad_no_aparece" />
    </LinearLayout>
</ScrollView>
