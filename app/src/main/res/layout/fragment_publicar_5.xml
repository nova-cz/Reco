<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_fondo_app"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="130dp">

            <include
                android:id="@+id/cabecera"
                layout="@layout/layout_cabecera_publicar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="@dimen/elevacion_suave"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_foto_placeholder"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/resumen_foto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resumen_titulo"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.fcc.reco.ui.comun.ChipInsignia
                            android:id="@+id/chip_grado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.fcc.reco.ui.comun.ChipInsignia
                            android:id="@+id/chip_bateria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/resumen_precio"
                        style="@style/Reco.Texto.Precio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="@dimen/elevacion_suave"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_detalles"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/editar"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/pub_editar"
                        android:textColor="@color/azul"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_alm_ram"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/det_almram"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_color"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/det_color"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_accesorios"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/det_accesorios"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_fotos_titulo"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/det_fotos"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pub_serie"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/det_id"
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="@dimen/elevacion_suave"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/punto"
                    style="@style/Reco.Texto.Boton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Reco.Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pub_horario"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tarjeta"
                android:elevation="@dimen/elevacion_suave"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    style="@style/Reco.Texto.Boton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pub_recibes_venta"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/recibes"
                    style="@style/Reco.Texto.Boton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/estado_verde"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/Reco.Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nota_naranja"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/pub_nota_revision"
                android:textColor="@color/estado_naranja"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/estado_naranja" />

            <LinearLayout
                android:id="@+id/fila_confirmo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/casilla_confirmo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:padding="4dp" />

                <TextView
                    style="@style/Reco.Texto.Cuerpo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/pub_confirmo"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                style="@style/Reco.Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/estado_rojo"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <com.fcc.reco.ui.comun.BotonPildora
        android:id="@+id/boton_siguiente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="16dp"
        android:text="@string/pub_enviar"
        app:botonIcono="@drawable/ic_chevron_der" />
</FrameLayout>