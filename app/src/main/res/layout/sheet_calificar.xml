<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/margen_pantalla"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/margen_pantalla"
    android:paddingBottom="24dp">

    <com.fcc.reco.ui.comun.AvatarIniciales
        android:id="@+id/avatar"
        android:layout_width="64dp"
        android:layout_height="64dp" />

    <TextView
        android:id="@+id/titulo"
        style="@style/Reco.Texto.Seccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <TextView
        style="@style/Reco.Texto.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/calificar_desc"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/estrellas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/etiquetas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp" />

    <EditText
        android:id="@+id/comentario"
        style="@style/Reco.Texto.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_campo"
        android:gravity="top|start"
        android:hint="@string/calificar_comentario"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="200"
        android:minLines="3"
        android:padding="14dp"
        android:textSize="14sp" />

    <com.fcc.reco.ui.comun.BotonPildora
        android:id="@+id/boton_enviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/calificar_enviar"
        app:botonIcono="@drawable/ic_chevron_der" />
</LinearLayout>
