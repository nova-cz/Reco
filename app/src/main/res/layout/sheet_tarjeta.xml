<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margen_pantalla"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/margen_pantalla"
    android:paddingBottom="24dp">

    <TextView
        style="@style/Reco.Texto.Seccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tarjeta_titulo" />

    <TextView
        style="@style/Reco.Texto.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tarjeta_desc"
        android:textSize="13sp" />

    <com.fcc.reco.ui.comun.CampoTexto
        android:id="@+id/campo_numero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:campoEtiqueta="@string/tarjeta_numero"
        app:campoHint="4242 4242 4242 4242"
        app:campoIcono="@drawable/ic_tarjeta"
        app:campoTipo="numero" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_vence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:campoEtiqueta="@string/tarjeta_vence"
            app:campoHint="12/30"
            app:campoIcono="@drawable/ic_reloj" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_cvc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:campoEtiqueta="@string/tarjeta_cvc"
            app:campoHint="123"
            app:campoIcono="@drawable/ic_candado"
            app:campoTipo="numero" />
    </LinearLayout>

    <com.fcc.reco.ui.comun.BotonPildora
        android:id="@+id/boton_guardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/guardar_tarjeta" />
</LinearLayout>
