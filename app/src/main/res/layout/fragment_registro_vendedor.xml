<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/boton_atras"
                style="@style/Reco.BotonCircular"
                android:contentDescription="@string/volver"
                android:src="@drawable/ic_atras" />

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/vende_barra"
                android:textSize="18sp" />
        </FrameLayout>

        <TextView
            style="@style/Reco.Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vende_titulo" />

        <TextView
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/vende_desc" />

        <!-- Lo que ganas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="@dimen/elevacion_suave"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vende_ganas"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circulo_verde_suave"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_escudo_ok"
                    app:tint="@color/verde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_1"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_1_desc"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circulo_acento"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_ubicacion"
                    app:tint="@color/verde_azulado" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_2"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_2_desc"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circulo_naranja_suave"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_tarjeta"
                    app:tint="@color/naranja" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Reco.Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_3"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Reco.Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vende_ganas_3_desc"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Las reglas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta"
            android:elevation="@dimen/elevacion_suave"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Reco.Texto.Boton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vende_reglas"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circulo_rojo_suave"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/estado_rojo" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/vende_regla_1"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circulo_rojo_suave"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/estado_rojo" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/vende_regla_2"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circulo_rojo_suave"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/estado_rojo" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/vende_regla_3"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Reco.Texto.Etiqueta"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circulo_rojo_suave"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/estado_rojo" />

                <TextView
                    style="@style/Reco.Texto.CuerpoMedio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/vende_regla_4"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Reco.Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/vende_datos" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_apodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:campoEtiqueta="@string/vende_apodo"
            app:campoHint="@string/vende_apodo_hint"
            app:campoIcono="@drawable/ic_perfil"
            app:campoTipo="texto" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_acerca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:campoEtiqueta="@string/vende_acerca"
            app:campoHint="@string/vende_acerca_hint"
            app:campoIcono="@drawable/ic_info"
            app:campoTipo="texto" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:campoEtiqueta="@string/registro_telefono"
            app:campoHint="222 123 4567"
            app:campoIcono="@drawable/ic_telefono"
            app:campoTipo="numero" />

        <TextView
            style="@style/Reco.Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_punto"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/selector_punto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ubicacion"
                app:tint="@color/texto_secundario" />

            <TextView
                android:id="@+id/punto_texto"
                style="@style/Reco.Texto.Cuerpo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/registro_punto_hint"
                android:textColor="@color/texto_secundario" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_abajo"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <TextView
            style="@style/Reco.Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registro_dias"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/fila_dias"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/fila_franjas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_clabe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:campoEtiqueta="@string/registro_clabe"
            app:campoHint="0021 8000 1234 5678 34"
            app:campoIcono="@drawable/ic_banco"
            app:campoTipo="numero" />

        <LinearLayout
            android:id="@+id/fila_reglas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/casilla_reglas"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Reco.Texto.Boton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_reglas"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Reco.Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_reglas_desc"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            style="@style/Reco.Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/estado_rojo"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_crear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/vende_unirme" />
    </LinearLayout>
</ScrollView>
