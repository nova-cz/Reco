<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_circulo_tinta"
            android:importantForAccessibility="no"
            android:padding="26dp"
            android:src="@drawable/ic_check"
            app:tint="@color/white" />

        <TextView
            style="@style/Reco.Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/compra_confirmada" />

        <TextView
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/compra_confirmada_desc" />

        <LinearLayout
            android:id="@+id/contenedor_pedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_compras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ver_mis_compras" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_explorar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/seguir_explorando"
            app:botonEstilo="secundario" />
    </LinearLayout>
</ScrollView>
