<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/boton_atras"
            style="@style/Reco.BotonCircular"
            android:contentDescription="@string/volver"
            android:src="@drawable/ic_atras" />

        <TextView
            android:id="@+id/titulo"
            style="@style/Reco.Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/login_titulo" />

        <TextView
            android:id="@+id/subtitulo"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/login_subtitulo" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:campoEtiqueta="@string/campo_correo"
            app:campoHint="@string/campo_correo_hint"
            app:campoIcono="@drawable/ic_correo"
            app:campoTipo="correo" />

        <com.fcc.reco.ui.comun.CampoTexto
            android:id="@+id/campo_contrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:campoEtiqueta="@string/campo_contrasena"
            app:campoHint="@string/campo_contrasena_hint"
            app:campoIcono="@drawable/ic_candado"
            app:campoTipo="contrasena" />

        <TextView
            android:id="@+id/olvidaste"
            style="@style/Reco.Texto.CuerpoMedio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="14dp"
            android:padding="4dp"
            android:text="@string/olvidaste_contrasena"
            android:textColor="@color/azul"
            android:textSize="13sp" />

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/iniciar_sesion" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_suave" />

            <TextView
                style="@style/Reco.Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/separador_o"
                android:textColor="@color/texto_secundario" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_suave" />
        </LinearLayout>

        <com.fcc.reco.ui.comun.BotonPildora
            android:id="@+id/boton_google"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/continuar_google"
            app:botonEstilo="secundario"
            app:botonIcono="@drawable/ic_google"
            app:botonIconoTinte="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/enlace_cambio"
            style="@style/Reco.Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/sin_cuenta" />
    </LinearLayout>
</ScrollView>
